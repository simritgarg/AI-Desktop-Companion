# ==============================================================================
# AI DESKTOP COMPANION & CAREER COMMAND CENTRE - SYSTEM ENVIRONMENT TEMPLATE
# Copy to .env and adjust local credentials as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION IDENTIFICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="AI Desktop Companion & Career Command Centre"
APP_ENV=production
APP_VERSION=2.0.0
PORT=3000
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. FRONTEND NETWORK & API ENDPOINTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Career Command Centre"
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8080/ws"
NEXT_PUBLIC_ENABLE_EXTERNAL_PLATFORMS=true
NEXT_PUBLIC_LEETCODE_API_URL="https://leetcode-stats-api.herokuapp.com/api"
NEXT_PUBLIC_GITHUB_API_URL="https://api.github.com/users"
NEXT_PUBLIC_CODEFORCES_API_URL="https://codeforces.com/api"

# ------------------------------------------------------------------------------
# 3. BACKEND & DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL="jdbc:h2:file:./data/companiondb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE"
SPRING_DATASOURCE_DRIVER="org.h2.Driver"
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=""
SPRING_JPA_HEBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 4. SECURITY & JWT CONFIGURATION
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 5. AI COACH ENGINE
# ------------------------------------------------------------------------------
AI_PROVIDER=local
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------------------------
# 6. DOCUMENTATION & SYSTEM SPECIFICATION FILE PATHS
# ------------------------------------------------------------------------------
IMPLEMENTATION_STATUS_DOC=./IMPLEMENTATION_STATUS.md
ARCHITECTURE_DOC=./ARCHITECTURE.md
DATABASE_DOC=./DATABASE.md
API_DOC=./API.md
FUNCTIONAL_TEST_REPORT_DOC=./FUNCTIONAL_TEST_REPORT.md
README_DOC=./README.md
AI_DOC=./AI.md
