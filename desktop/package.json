{
  "name": "ai-desktop-companion",
  "version": "1.0.0",
  "description": "AI Desktop Companion - Personal AI Friend, Accountability Coach & Desktop Overlay",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:next": "next dev -p 3000",
    "build:next": "next build",
    "start:next": "next start -p 3000",
    "compile:electron": "tsc -p tsconfig.electron.json",
    "dev:electron": "concurrently \"npm run dev:next\" \"npm run compile:electron && wait-on http://localhost:3000 && electron .\"",
    "build:app": "npm run build:next && npm run compile:electron && electron-builder"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "auto-launch": "^5.0.6",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "lucide-react": "^0.359.0",
    "next": "^14.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "wait-on": "^7.2.0"
  }
}
